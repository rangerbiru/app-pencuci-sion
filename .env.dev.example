# Lingkungan
ENV=development
# Dipakai `npm run dev`. `npm run dev:lan` mengabaikannya dan memakai IP LAN laptop terdeteksi
# (lihat README, Menjalankan dengan Laravel lokal).
API_URL=http://127.0.0.1:8000/api/v1

# EXPO (owner dan project ID ada di app.config.ts)
EXPO_SLUG=sion-mobile
EXPO_NAME="SION Dev"
EXPO_IOS_BUNDLE_IDENTIFIER=id.sion.mobile.dev
EXPO_ANDROID_PACKAGE=id.sion.mobile.dev
