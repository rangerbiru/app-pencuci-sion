# Lingkungan
ENV=development
# HP fisik: pakai IP laptop di Wi-Fi yang sama, mis. http://192.168.1.10:8000 (tanpa /api/v1)
# (jalankan Laravel dengan: php artisan serve --host=0.0.0.0)
API_URL=http://192.168.1.10:8000

# EXPO (diisi sendiri)
EXPO_OWNER=
EXPO_PROJECT_ID=
EXPO_SLUG=sion-mobile
EXPO_NAME="SION Dev"
EXPO_IOS_BUNDLE_IDENTIFIER=id.sion.mobile.dev
EXPO_ANDROID_PACKAGE=id.sion.mobile.dev
